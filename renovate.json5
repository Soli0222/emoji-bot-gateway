{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'security:minimumReleaseAgeNpm',
    ':dependencyDashboard',
  ],
  pinDigests: false,
  timezone: 'Asia/Tokyo',
  rangeStrategy: 'bump',
  prConcurrentLimit: 20,
  prHourlyLimit: 10,
  reviewers: [
    'Soli0222',
  ],
  assignees: [
    'Soli0222',
  ],
  semanticCommits: 'enabled',
  prCreation: 'immediate',
  rebaseWhen: 'auto',
  dependencyDashboard: true,
  vulnerabilityAlerts: {
    enabled: true,
    labels: [
      'security',
    ],
  },
  'helm-values': {
    enabled: false,
  },
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^charts/.+/values\\.yaml$/',
      ],
      matchStrings: [
        'repository:\\s*(?<depName>[^\\s]+)\\s+tag:\\s*["\'](?<currentValue>[^"\']+)["\']',
      ],
      datasourceTemplate: 'docker',
      versioningTemplate: 'docker',
    },
  ],
  // chart の image tag を上げたら同じ PR で chart version の patch を上げる。
  // これが無いと chart-guard の経路 B が成立しない。
  // experimental な機能なので renovate のバージョン更新時は挙動を確認する。
  bumpVersions: [
    {
      filePatterns: [
        '{{packageFileDir}}/Chart.yaml',
      ],
      matchStrings: [
        '(?:^|\\n)version:\\s*(?<version>[^\\s]+)',
      ],
      bumpType: 'patch',
    },
  ],
  packageRules: [
    {
      description: 'Keep TypeScript 6 until typescript-eslint supports TypeScript 7 (https://github.com/Soli0222/emoji-bot-gateway/issues/215)',
      matchManagers: ['npm'],
      matchFileNames: ['package.json'],
      matchPackageNames: ['typescript'],
      allowedVersions: '<7',
    },
    {
      matchManagers: [
        'github-actions',
      ],
      commitMessageTopic: 'GitHub Action {{depName}}',
      automerge: true,
    },
    {
      matchManagers: [
        'docker-compose',
        'dockerfile',
      ],
      matchDepNames: [
        '!node',
      ],
      commitMessageTopic: 'Docker {{depName}}',
      semanticCommitType: 'fix',
      automerge: true,
    },
    {
      matchDepNames: [
        'node',
      ],
      groupName: 'node',
      commitMessageTopic: 'Node.js',
      semanticCommitType: 'fix',
      automerge: true,
    },
    {
      matchManagers: [
        'npm',
      ],
      commitMessageTopic: 'Node {{depName}}',
      semanticCommitType: 'fix',
      automerge: true,
    },
    {
      matchManagers: [
        'custom.regex',
      ],
      matchFileNames: [
        'charts/**/values.yaml',
      ],
      commitMessageTopic: 'Chart image {{depName}}',
      // fix(chart) だと release-please がアプリのリリースとして拾ってしまい、
      // コードが1行も変わっていないのに依存イメージのタグを上げただけで
      // アプリのリリースが発生する。chart の変更は chart の publish だけで完結させる。
      semanticCommitType: 'chore',
      semanticCommitScope: 'chart',
      addLabels: [
        'chart',
      ],
      // 経路 B (image tag だけの変更 + chart version の patch bump)。
      // chart-guard が分類を強制するので automerge して良い。
      automerge: true,
      automergeType: 'pr',
      platformAutomerge: false,
    },
    {
      matchManagers: [
        'custom.regex',
      ],
      matchFileNames: [
        'charts/**/values.yaml',
      ],
      matchUpdateTypes: [
        'major',
      ],
      automerge: false,
      addLabels: [
        'major-update',
      ],
    },
    {
      "description": "Track the latest stable Node.js release, including new majors before LTS.",
      "matchPackageNames": [
        "node",
        "@types/node"
      ],
      "versioning": "npm",
      "enabled": true,
      "ignoreUnstable": true,
      "separateMajorMinor": false,
      "automerge": true,
      "semanticCommitType": "fix"
    },
    {
      "description": "Do not delay runtime security updates; keep npm package cooldowns.",
      "matchPackageNames": [
        "node"
      ],
      "groupName": "Node.js",
      "prPriority": 10,
      "prConcurrentLimit": 0,
      "branchConcurrentLimit": 0,
      "prHourlyLimit": 0,
      "minimumReleaseAge": "0 days",
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "description": "Separate the Docker variant from the stable Node.js version.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "node"
      ],
      "versionCompatibility": "^(?<version>[^-]+)(?<compatibility>-.*)?$"
    },
  ],
}
