{
  "name": "emoji-bot-gateway",
  "version": "1.5.0",
  "description": "Misskey Emoji Bot Gateway - AI-powered emoji generation and registration",
  "main": "dist/main.js",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "ioredis": "^5.10.1",
    "misskey-js": "2026.10.0",
    "openai": "^6.37.0",
    "pino": "^10.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.9",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.12.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.11"
  }
}
